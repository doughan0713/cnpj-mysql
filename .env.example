# Configurações de Banco de Dados para Ingestão de Dados de CNPJ
# Renomeie este arquivo para .env e preencha com os seus dados

# Tipo do Banco de Dados: mysql ou postgres
DB_TYPE=mysql

# Nome do banco de dados (deve estar criado no servidor)
DB_NAME=cnpj

# Usuário de conexão ao banco de dados
DB_USER=root

# Senha de conexão ao banco de dados (padrão vazio se não houver senha)
DB_PASS=

# Host do servidor do banco de dados
DB_HOST=127.0.0.1

# Porta do servidor do banco de dados (padrão 3306 para mysql ou 5432 para postgres)
DB_PORT=3306
