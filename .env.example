# Template configuration for CNPJ database ingestion
# Copy this file to '.env' and adjust the variables accordingly.

# Database type: 'mysql' or 'postgres'
DB_TYPE=mysql

# Connection details
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cnpj
DB_USER=root
# DB_PASS should be left blank or set securely. Avoid hardcoding passwords in files committed to version control.
DB_PASS=
