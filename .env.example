# Configuração de Banco de Dados para Ingestão CNPJ
# Renomeie este arquivo para .env e preencha com as suas credenciais

# Tipo de banco: 'mysql' ou 'postgres'
DB_TYPE=mysql

# Nome do banco de dados (deve ser criado previamente no servidor)
DB_NAME=cnpj

# Usuário de acesso ao banco de dados
DB_USER=root

# Senha de acesso ao banco de dados
DB_PASS=

# Endereço do servidor do banco de dados
DB_HOST=127.0.0.1

# Porta do banco de dados (padrão: 3306 para MySQL, 5432 para PostgreSQL)
DB_PORT=3306
